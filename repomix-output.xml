// src/components/Calendar.jsx
import { useState, useRef, useMemo, useCallback, useEffect } from "react"
import DayCell from "./DayCell"
import PropTypes from 'prop-types'
import { getColorToken } from '../utils/m3Palette'

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

function getDaysInMonth(year, month) {
  return new Date(year, month + 1, 0).getDate()
}

function getFirstDayOfMonth(year, month) {
  const day = new Date(year, month, 1).getDay()
  return (day + 6) % 7
}

function getNextMonth(year, month) {
  return month === 11 ? { year: year + 1, month: 0 } : { year, month: month + 1 }
}

function getPrevMonth(year, month) {
  return month === 0 ? { year: year - 1, month: 11 } : { year, month: month - 1 }
}

export default function Calendar({ entries, events, onSelectDate }) {
const today = useMemo(() => new Date(), [])
  const [year, setYear] = useState(today.getFullYear())
  const [month, setMonth] = useState(today.getMonth())

  // Real-time display date: updates at Frame 0 for instant, zero-lag title changes
  const [displayDate, setDisplayDate] = useState(() => ({
    year: today.getFullYear(),
    month: today.getMonth()
  }))

  // Gesture State
  const [dragOffset, setDragOffset] = useState(0)
  const [isAnimating, setIsAnimating] = useState(false)
  const pendingActionRef = useRef(null) // 'next' | 'prev' | null
  const safetyTimerRef = useRef(null)

  // Touch tracking refs
  const touchStartX = useRef(0)
  const touchStartY = useRef(0)
  const touchStartTime = useRef(0)
  const isHorizontalGesture = useRef(null)
  const containerRef = useRef(null)

  const prevDate = useMemo(() => getPrevMonth(year, month), [year, month])
  const nextDate = useMemo(() => getNextMonth(year, month), [year, month])

  // Synchronized with displayDate for instant FAB and title reactivity
  const isCurrentMonth = displayDate.year === today.getFullYear() && displayDate.month === today.getMonth()

  const monthLabel = useMemo(() => {
    return new Date(displayDate.year, displayDate.month).toLocaleString("default", {
      month: "long", year: "numeric"
    })
  }, [displayDate.year, displayDate.month])

  // Instantly commits any pending transition
  const flushPendingTransition = useCallback(() => {
    clearTimeout(safetyTimerRef.current)
    if (!pendingActionRef.current) {
      setIsAnimating(false)
      setDragOffset(0)
      return
    }

    const action = pendingActionRef.current
    pendingActionRef.current = null
    setIsAnimating(false)
    setDragOffset(0)

    if (action === 'next') {
      setYear(nextDate.year)
      setMonth(nextDate.month)
      setDisplayDate(nextDate)
    } else if (action === 'prev') {
      setYear(prevDate.year)
      setMonth(prevDate.month)
      setDisplayDate(prevDate)
    }
  }, [nextDate, prevDate])

  // Cleanup safety timer on unmount
  useEffect(() => {
    return () => clearTimeout(safetyTimerRef.current)
  }, [])

  // --- Touch Gesture Handlers ---

  function handleTouchStart(e) {
    if (isAnimating) {
      flushPendingTransition()
    }

    touchStartX.current = e.touches[0].clientX
    touchStartY.current = e.touches[0].clientY
    touchStartTime.current = Date.now()
    isHorizontalGesture.current = null
  }

  function handleTouchMove(e) {
    const currentX = e.touches[0].clientX
    const currentY = e.touches[0].clientY
    const deltaX = currentX - touchStartX.current
    const deltaY = currentY - touchStartY.current

    if (isHorizontalGesture.current === null) {
      if (Math.abs(deltaX) > 8 || Math.abs(deltaY) > 8) {
        isHorizontalGesture.current = Math.abs(deltaX) > Math.abs(deltaY)
      }
    }

    if (isHorizontalGesture.current) {
      setDragOffset(deltaX)
    }
  }

  function handleTouchEnd(e) {
    if (!isHorizontalGesture.current) {
      setDragOffset(0)
      return
    }

    const currentX = e.changedTouches[0].clientX
    const deltaX = currentX - touchStartX.current
    const duration = Date.now() - touchStartTime.current
    const velocity = Math.abs(deltaX) / Math.max(duration, 1)
    const containerWidth = containerRef.current?.offsetWidth || 340

    // Threshold: 40px drag or quick flick (velocity > 0.3)
    const isSwipe = Math.abs(deltaX) > 40 || velocity > 0.3

    if (isSwipe && deltaX < 0) {
      // Swiped Left -> Immediately update header to Next Month (0ms delay)
      setDisplayDate(nextDate)
      pendingActionRef.current = 'next'
      setIsAnimating(true)
      setDragOffset(-containerWidth)
      safetyTimerRef.current = setTimeout(flushPendingTransition, 220)
    } else if (isSwipe && deltaX > 0) {
      // Swiped Right -> Immediately update header to Prev Month (0ms delay)
      setDisplayDate(prevDate)
      pendingActionRef.current = 'prev'
      setIsAnimating(true)
      setDragOffset(containerWidth)
      safetyTimerRef.current = setTimeout(flushPendingTransition, 220)
    } else {
      // Snap back to current
      setDisplayDate({ year, month })
      setIsAnimating(true)
      setDragOffset(0)
      safetyTimerRef.current = setTimeout(flushPendingTransition, 220)
    }
  }

  function handleTransitionEnd() {
    flushPendingTransition()
  }

  // --- Button Navigation ---

  function scrollToPrev() {
    if (isAnimating) flushPendingTransition()
    const containerWidth = containerRef.current?.offsetWidth || 340
    // Immediately flip header to prev month
    setDisplayDate(prevDate)
    pendingActionRef.current = 'prev'
    setIsAnimating(true)
    setDragOffset(containerWidth)
    safetyTimerRef.current = setTimeout(flushPendingTransition, 220)
  }

  function scrollToNext() {
    if (isAnimating) flushPendingTransition()
    const containerWidth = containerRef.current?.offsetWidth || 340
    // Immediately flip header to next month
    setDisplayDate(nextDate)
    pendingActionRef.current = 'next'
    setIsAnimating(true)
    setDragOffset(-containerWidth)
    safetyTimerRef.current = setTimeout(flushPendingTransition, 220)
  }

  function goToToday() {
    clearTimeout(safetyTimerRef.current)
    pendingActionRef.current = null
    setIsAnimating(false)
    setDragOffset(0)
    const todayState = { year: today.getFullYear(), month: today.getMonth() }
    setDisplayDate(todayState)
    setYear(todayState.year)
    setMonth(todayState.month)
  }

  // Renders the month grid. Off-screen preview panels pass isInteractive=false
  // to render static <div> elements, fully eliminating aria-hidden-focus violations.
  function renderMonthGrid(y, m, isInteractive = true) {
    const daysInMonth = getDaysInMonth(y, m)
    const firstDaySlot = getFirstDayOfMonth(y, m)
    const cells = []

    for (let i = 0; i < firstDaySlot; i++) {
      cells.push(<div key={`empty-${y}-${m}-${i}`} />)
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const dateKey = `${y}-${String(m + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`
      const isToday =
        day === today.getDate() &&
        m === today.getMonth() &&
        y === today.getFullYear()

      const dayEvents = events.filter(e => e.date === dateKey)
      const entryColor = entries[dateKey]?.color || null

      if (isInteractive) {
        cells.push(
          <DayCell
            key={dateKey}
            day={day}
            dateKey={dateKey}
            isToday={isToday}
            entryColor={entryColor}
            events={dayEvents}
            onClick={() => onSelectDate(dateKey)}
          />
        )
      } else {
        // Non-focusable static tile for preview panels (guarantees 0 aria-hidden-focus violations)
        const token = getColorToken(entryColor)
        cells.push(
          <div
            key={dateKey}
            className="relative flex flex-col items-center justify-start w-full aspect-square rounded-xl pt-1.5 pb-1 bg-[#EEF2FF] text-[#1E1B4B] border border-white/60 font-medium select-none pointer-events-none"
            style={
              token
                ? { backgroundColor: token.container, color: token.onContainer }
                : undefined
            }
          >
            <span className="text-sm leading-tight">{day}</span>
          </div>
        )
      }
    }

    return (
      <div className="grid grid-cols-7 gap-1.5 w-full select-none">
        {cells}
      </div>
    )
  }

  return (
    <section aria-label="Calendar" className="flex-1 flex flex-col w-full">
      {/* Month Header Bar */}
      <div className="flex items-center justify-between mb-3 px-1">
        <button
          onClick={scrollToPrev}
          aria-label="Previous month"
          className="w-12 h-12 flex items-center justify-center rounded-full text-[#1E1B4B] hover:bg-black/5 active:bg-black/10 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1E1B4B]"
        >
          <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <h2 className="text-lg font-bold text-[#1E1B4B] tracking-tight select-none">{monthLabel}</h2>
        <button
          onClick={scrollToNext}
          aria-label="Next month"
          className="w-12 h-12 flex items-center justify-center rounded-full text-[#1E1B4B] hover:bg-black/5 active:bg-black/10 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1E1B4B]"
        >
          <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      {/* Weekday headers — WCAG AAA contrast (#1E1B4B on #A5B4FC) */}
      <div className="grid grid-cols-7 mb-1.5 select-none">
        {DAYS.map(d => (
          <div
            key={d}
            className="text-center text-xs font-bold text-[#1E1B4B] py-1 select-none"
            aria-hidden="true"
          >
            {d}
          </div>
        ))}
      </div>

      {/* Strict 100% Viewport Container (Zero bleeding / zero peeking) */}
      <div
        ref={containerRef}
        onTouchStart={handleTouchStart}
        onTouchMove={handleTouchMove}
        onTouchEnd={handleTouchEnd}
        className="w-full flex-1 flex flex-col overflow-hidden touch-pan-y select-none"
      >
        {/* 300% Width Track: exactly 3 equal panels resting at -33.333333% */}
        <div
          onTransitionEnd={handleTransitionEnd}
          className="flex will-change-transform flex-1"
          style={{
            width: '300%',
            transform: `translate3d(calc(-33.333333% + ${dragOffset}px), 0, 0)`,
            transition: isAnimating ? 'transform 180ms cubic-bezier(0.2, 0, 0, 1)' : 'none',
          }}
        >
          {/* Panel -1: Previous Month (Static Tiles, No Focusable Buttons) */}
          <div className="w-1/3 flex-shrink-0 px-0.5 h-full flex flex-col" aria-hidden="true">
            {renderMonthGrid(prevDate.year, prevDate.month, false)}
            <div className="flex-1 min-h-[5rem]" />
          </div>

          {/* Panel 0: Current Active Month (Interactive Buttons) */}
          <div className="w-1/3 flex-shrink-0 px-0.5 h-full flex flex-col">
            {renderMonthGrid(year, month, true)}
            <div className="flex-1 min-h-[5rem]" />
          </div>

          {/* Panel +1: Next Month (Static Tiles, No Focusable Buttons) */}
          <div className="w-1/3 flex-shrink-0 px-0.5 h-full flex flex-col" aria-hidden="true">
            {renderMonthGrid(nextDate.year, nextDate.month, false)}
            <div className="flex-1 min-h-[5rem]" />
          </div>
        </div>
      </div>

      {/* M3 Tonal FAB for "Today" */}
      <div className="fixed bottom-24 left-0 right-0 max-w-lg mx-auto px-4 pointer-events-none flex justify-end z-20">
        <button
          onClick={goToToday}
          aria-label="Jump back to current month"
          tabIndex={isCurrentMonth ? -1 : 0}
          className={`pointer-events-auto flex items-center h-12 px-5 rounded-2xl bg-[#EEF2FF] text-[#1E1B4B] hover:bg-white active:scale-95 border border-black/10 font-semibold text-xs tracking-wide shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1E1B4B] ${
            isCurrentMonth
              ? "opacity-0 translate-y-3 pointer-events-none"
              : "opacity-100 translate-y-0"
          }`}
        >
          <svg
            className="w-4 h-4 mr-2 flex-shrink-0 text-[#1E1B4B]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2.2}
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
          <span>Today</span>
        </button>
      </div>
    </section>
  )
}

Calendar.propTypes = {
  entries: PropTypes.objectOf(
    PropTypes.shape({
      note:     PropTypes.string,
      color:    PropTypes.string,
      category: PropTypes.string,
    })
  ).isRequired,
  events: PropTypes.arrayOf(
    PropTypes.shape({
      id:    PropTypes.number.isRequired,
      date:  PropTypes.string.isRequired,
      title: PropTypes.string.isRequired,
      color: PropTypes.string.isRequired,
    })
  ).isRequired,
  onSelectDate: PropTypes.func.isRequired,
}
