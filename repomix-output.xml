/* src/index.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html, body, #root {
    width: 100%;
    overflow-x: hidden;
    margin: 0;
    padding: 0;
  }
}

/* Register Houdini angle property for smooth, corner-safe clockwise gradient rotation */
@property --glow-angle {
  syntax: '<angle>';
  initial-value: 0deg;
  inherits: false;
}

@layer utilities {
  /* Hide scrollbars while retaining touch scroll physics */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* --- Material Design 3 Motion Utilities --- */

  /* Modal Scrim Backdrop Fade */
  .animate-m3-backdrop-enter {
    animation: m3BackdropEnter 180ms cubic-bezier(0, 0, 0.2, 1) forwards;
  }

  .animate-m3-backdrop-exit {
    animation: m3BackdropExit 150ms cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  /* M3 Dialog / Modal Scale-Fade */
  .animate-m3-dialog-enter {
    animation: m3DialogEnter 220ms cubic-bezier(0.05, 0.7, 0.1, 1.0) forwards;
    will-change: transform, opacity;
  }

  .animate-m3-dialog-exit {
    animation: m3DialogExit 150ms cubic-bezier(0.3, 0.0, 0.8, 0.15) forwards;
    will-change: transform, opacity;
  }

  /* M3 Fade-Through for Tabs */
  .animate-m3-fade-through {
    animation: m3FadeThrough 200ms cubic-bezier(0, 0, 0.2, 1) forwards;
    will-change: opacity;
  }

  /* --- Clockwise Border Glow + Double Settle Pulse for Today's Date --- */
  .today-glow-border {
    position: relative;
  }

  /* 1. The Clockwise Perimeter Sweep */
  .today-glow-border::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 0.85rem;
    padding: 2px;
    background: conic-gradient(
      from var(--glow-angle),
      transparent 0deg,
      transparent 180deg,
      #818CF8 270deg,
      #4F46E5 330deg,
      #EEF2FF 360deg
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: m3ClockwiseBorderSweep 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: opacity;
  }

  /* 2. The High-Contrast Double Settle Pulse */
  .today-glow-border::after {
    content: '';
    position: absolute;
    inset: -2.5px;
    border-radius: 0.85rem;
    border: 3px solid #EEF2FF;
    box-shadow: 0 0 0 2px #4338CA, 0 0 10px rgba(99, 102, 241, 0.7);
    opacity: 0;
    pointer-events: none;
    animation: m3TodayBorderPulse 4s cubic-bezier(0.2, 0, 0, 1) infinite;
    will-change: transform, opacity;
  }
}

/* --- Keyframe Definitions --- */

@keyframes m3BackdropEnter {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes m3BackdropExit {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes m3DialogEnter {
  from {
    opacity: 0;
    transform: scale3d(0.94, 0.94, 1);
  }
  to {
    opacity: 1;
    transform: scale3d(1, 1, 1);
  }
}

@keyframes m3DialogExit {
  from {
    opacity: 1;
    transform: scale3d(1, 1, 1);
  }
  to {
    opacity: 0;
    transform: scale3d(0.96, 0.96, 1);
  }
}

@keyframes m3FadeThrough {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Phase 1: 1s Clockwise Sweep (0% -> 25%) */
@keyframes m3ClockwiseBorderSweep {
  0% {
    --glow-angle: 0deg;
    opacity: 0;
  }
  2% {
    opacity: 1;
  }
  23% {
    opacity: 1;
  }
  25% {
    --glow-angle: 360deg;
    opacity: 0;
  }
  100% {
    --glow-angle: 360deg;
    opacity: 0;
  }
}

/* Phase 2: Single Smooth Settle Pulse (25% -> 35%), then Quiet Rest until 100% */
@keyframes m3TodayBorderPulse {
  0%, 24% {
    opacity: 0;
    transform: scale3d(1, 1, 1);
  }
  /* Peak expansion of the single smooth pulse */
  29% {
    opacity: 1;
    transform: scale3d(1.11, 1.11, 1);
  }
  /* Gentle, fluid dissolve back to base */
  35% {
    opacity: 0;
    transform: scale3d(1, 1, 1);
  }
  100% {
    opacity: 0;
    transform: scale3d(1, 1, 1);
  }
}

/* --- Accessibility: Respect reduced motion preference --- */
@media (prefers-reduced-motion: reduce) {
  .animate-m3-backdrop-enter,
  .animate-m3-backdrop-exit,
  .animate-m3-dialog-enter,
  .animate-m3-dialog-exit,
  .animate-m3-fade-through,
  .today-glow-border::before,
  .today-glow-border::after {
    animation: none !important;
    transition: none !important;
  }
}
</file>

