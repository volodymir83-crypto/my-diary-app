        </button>
      </div>

      {/* ========================================================= */}
      {/* TAB 1: MANAGE RECURRING ACTIONS                           */}
      {/* ========================================================= */}
      {activeTab === 'manage' && (
        <div className="flex flex-col gap-4">
          {/* Top Button: "+ Create new one" */}
